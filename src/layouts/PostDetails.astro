---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import TOC from "@components/TOC.tsx";
import type { MarkdownInstance } from "astro";
import type { Frontmatter } from "src/types";
import GoBackButton from "../components/GoBackButton.astro";

export interface Props {
  post: MarkdownInstance<Frontmatter>;
}

const { frontmatter, Content } = Astro.props.post;

const { title, author, description, ogImage, datetime, tags } = frontmatter;
---

<Layout
  title={title}
  author={author}
  description={description}
  ogImage={ogImage}
>
  <Header />
  <div>
    <div class="bg-white shadow">
      <div class="max-w-7xl mx-auto py-1 bg-gray-100">Quora</div>
    </div>

    <div class="bg-red-50">
      <div class="mx-auto grid grid-cols-12 bg-red-200 max-w-7xl">
        <div class="xl:col-span-3 hidden xl:block"></div>
        <div
          class="col-span-12
                lg:col-span-10
                xl:col-span-6
                bg-gray-300"
        >
          <div>
            <div class="justify-start mx-auto">
              <h1 class="post-title">{title}</h1>
              <Datetime datetime={datetime} size="lg" className="my-2" />
              <ul class="tags-container">
                {tags?.map(tag => <Tag name={tag} size="sm" />)}
              </ul>
            </div>
            <article id="article" role="article" class="mt-8 prose max-w-3xl">
              <Content />
            </article>
          </div>
        </div>
        <div class="col-span-3 hidden lg:block">
          <TOC headings={Astro.props.post.getHeadings()} />
        </div>
      </div>
    </div>
  </div>
  <Footer />
</Layout>

<style>
  main {
    @apply px-2 pb-12 mx-auto w-full;
  }

  #main-content-wrapper {
    @apply mx-auto;
  }

  .post-title {
    @apply font-semibold text-2xl text-skin-accent;
  }

  .tags-container {
    @apply my-1 text-sm;
  }

  .toc {
    @apply text-xs border-l-2 pl-4;
  }

  .toc a {
  }
</style>
