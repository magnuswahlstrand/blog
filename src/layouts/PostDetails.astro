---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import TOC from "@components/TOC.tsx";
import type { MarkdownInstance } from "astro";
import type { Frontmatter } from "src/types";
import GoBackButton from "../components/GoBackButton.astro";

export interface Props {
  post: MarkdownInstance<Frontmatter>;
}

const { frontmatter, Content } = Astro.props.post;

const { title, author, description, ogImage, datetime, tags } = frontmatter;
---

<Layout
  title={title}
  author={author}
  description={description}
  ogImage={ogImage}
>
  <Header />
  <div class="">
    <div class="mx-auto grid grid-cols-12 max-w-7xl">
      <div class="col-1"></div>
      <div class="col-2">
        <GoBackButton />
        <div class="justify-start mx-auto">
          <h1 class="post-title">{title}</h1>
          <Datetime datetime={datetime} size="lg" className="my-2" />
          <ul class="tags-container">
            {tags?.map(tag => <Tag name={tag} size="sm" />)}
          </ul>
        </div>
      </div>
      <div class="col-3"></div>
    </div>
    <div class="mx-auto grid grid-cols-12 max-w-7xl mt-4">
      <!--Col 1 -->
      <div class="col-1"></div>

      <!--Col 2 -->
      <div class="col-2">
        <div>
          <article id="article" role="article" class="prose max-w-3xl mb-24">
            <Content />
          </article>
        </div>
      </div>

      <!--Col 3 -->
      <div class="col-3 border-l-2 pl-3 prose-li:decoration-0">
        <TOC headings={Astro.props.post.getHeadings()} />
      </div>
    </div>
  </div>
  <Footer />
</Layout>

<style>
  .col-1 {
    @apply xl:col-span-3 hidden xl:block;
  }

  .col-2 {
    @apply col-span-12 lg:col-span-9 xl:col-span-6 px-4;
  }

  .col-3 {
    @apply lg:col-span-3 hidden lg:block;
  }

  main {
    @apply px-2 pb-12 mx-auto w-full;
  }

  #main-content-wrapper {
    @apply mx-auto;
  }

  .post-title {
    @apply font-semibold text-2xl text-skin-accent;
  }

  .tags-container {
    @apply my-1 text-sm;
  }

  .toc {
    @apply text-xs border-l-2 pl-4;
  }

  .toc a {
  }
</style>
