  <Footer />
</Layout>

<style>
  main {
    @apply pb-12 mx-auto max-w-3xl w-full;
  }

  .row {
    @apply mx-auto flex px-4;
  }

  #main-content-wrapper {
    @apply mx-auto;
  }

  .post-title {
    @apply font-semibold text-2xl text-skin-accent;
  }

  .tags-container {
    @apply my-1 text-sm;
  }

  .left-column {
    @apply w-[300px] hidden 2xl:block;
  }

  .right-column {
    @apply w-[300px] hidden xl:block;
  }

  .toc {
    @apply right-column text-xs border-l-2 pl-6;
  }

  .toc a {
  }
</style>
