---
import { calculateDuration } from "../resume/resumeItems";
import SocialsButton from "./SocialsButton.astro";
export interface Props {
  company: {
    name: string;
    linkedin: string;
    location: string;
  };
  title: string;
  description: string;
  type: string;
  from: string;
  to: string;
  tags: string[];
  isOngoing?: boolean;
}

const item = Astro.props;
---

<div class="rounded border border-slate-500 text-skin-base">
  <div class="flex justify-between border-b border-slate-500 px-4 py-2">
    <div class="flex flex-row gap-2 items-center">
      <div class="font-bold">{item.company.name}</div>
      <SocialsButton
        name="Linkedin"
        href={item.company.linkedin}
        className="mb-1 pt-0"
      />
    </div>
    <div class="flex flex-col text-xs">
      <div class="text-right">
        {item.type} · {calculateDuration(item.from, item.to)}
      </div>
      <div class="text-right">
        {item.from} - {item.isOngoing ? "Present" : item.to}
      </div>
    </div>
  </div>
  <div class="px-4 py-2 text-sm">
    <div class="font-bold">{item.title}</div>
    <div class="">{item.company.location}</div>
    <div class="mt-2 prose-sm"><p>{item.description}</p></div>
    <div class="flex flex-row gap-2 mt-3">
      <div class="font-bold">Skills:</div>
      <div class="flex flex-row flex-wrap gap-x-2">
        {
          item.tags.map((tag, index) => (
            <div class="text-skin-accent">
              {tag} {index !== item.tags.length - 1 ? "·" : ""}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

