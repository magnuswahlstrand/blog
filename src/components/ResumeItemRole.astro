---
import { calculateDuration } from "../resume/resumeItems";
import SocialsButton from "./SocialsButton.astro";
export interface Props {
  role: {
    location: string;
    title: string;
    description: string;
    from: string;
    to: string;
    tags: string[];
  };
  isMultiRow: boolean;
  isFirst: boolean;
}

function formatParagraphs(input: string): string {
  const lines = input.split("\n");

  const formattedLines = lines.map(line => `<p>${line}</p>`);

  return formattedLines.join("");
}

const { isFirst, isMultiRow, role } = Astro.props;
const timespanText = `${role.from} - ${role.to}`;
---

<div
  class:list={[
    "px-4 pt-2 pb-4 text-sm",
    !isFirst ? "border-t border-slate-500 pt-4" : "",
  ]}
>
  <div class="flex flex-row gap-2 items-center justify-between">
    <div class="font-bold">{role.title}</div>
    {isMultiRow && <div class="text-xs sm:block hidden">{timespanText}</div>}
  </div>
  <div>{role.location}</div>
  {isMultiRow && <div class="text-xs sm:hidden">{timespanText}</div>}
  <div class="mt-2 prose-sm" set:html={formatParagraphs(role.description)}>
  </div>
  <div class={`flex flex-row gap-2 mt-3`}>
    <div class="font-bold">Skills:</div>
    <div class="flex flex-row flex-wrap gap-x-2">
      {
        role.tags.map((tag, index) => (
          <div class="text-skin-accent">
            {tag} {index !== role.tags.length - 1 ? "·" : ""}
          </div>
        ))
      }
    </div>
  </div>
</div>
