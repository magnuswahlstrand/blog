---
import { Code } from "astro/components";
import { ClipboardCopy } from "@astro-github-elements/clipboard-copy";

export interface Props {
  repo: string;
  path: string;
}

const { repo, path } = Astro.props;
const rawUrl = `https://raw.githubusercontent.com/${repo}/main/${path}`;
const url = `https://github.com/${repo}/blob/main/${path}`;
const fileEnding = url.split(".").pop();

const response = await fetch(rawUrl);
const code = await response.text();
---

<div>
  <div class="flex flex-row justify-between relative top-8 overflow-clip">
    <a
      class="bg-[#282c34] rounded-t-lg z px-5 pt-1 pb-3 !text-white text-sm sm:text-base"
      href={url}>{path}</a
    >
    <a
      class="bg-[#282c34] rounded-t-lg z px-5 pt-1 pb-3 !text-white text-sm sm:text-base"
      href="#"
      onclick="return false;"
    >
      <ClipboardCopy value={code}>copy</ClipboardCopy>
    </a>
  </div>

  <Code code={code} lang={fileEnding} theme="one-dark-pro" />
</div>
