---
import type { MarkdownInstance } from "astro";
import MySiteLayout from "../layouts/AboutNowLayout.astro";
import ResumeItem from "../components/ResumeItem.astro";
import type { Frontmatter } from "../types";
import slugify from "../utils/slugify";
import Card from "../components/Card";

const recipes = Object.values(
  import.meta.glob<MarkdownInstance<Frontmatter>>("./recipes/*.{md,mdx}", {
    eager: true,
  })
);
---

<MySiteLayout frontmatter={{ title: "Recipes" }}>
  <ul>
    {
      recipes.map(recipe => (
        <li>
          <a href={recipe.url}>{recipe.frontmatter.title}</a>
        </li>
      ))
    }
  </ul>
</MySiteLayout>
