---
import MySiteLayout from "../layouts/AboutNowLayout.astro";
import SortableTable from "../components/SortableTable.astro";
import { recipes } from "../recipes";

const entries = Object.entries(recipes).sort((a, b) =>
  (b[1].added ?? "").localeCompare(a[1].added ?? "")
);
---

<MySiteLayout frontmatter={{ title: "Recipes", navName: "lists" }}>
  <SortableTable>
    <thead>
      <tr>
        <th data-sort="asc" data-type="text">Recipe</th>
        <th data-sort="desc" data-type="text">Added</th>
        <th data-type="none">Source</th>
      </tr>
    </thead>
    <tbody>
      {
        entries.map(([slug, recipe]) => (
          <tr>
            <td>
              <a href={`/recipes/${slug}`}>{recipe.title}</a>
            </td>
            <td>
              {recipe.added
                ? new Date(recipe.added + "-01").toLocaleDateString("en-US", {
                    month: "short",
                    year: "numeric",
                  })
                : "–"}
            </td>
            <td>
              {recipe.sources?.[0] && <a href={recipe.sources[0].url}>link</a>}
            </td>
          </tr>
        ))
      }
    </tbody>
  </SortableTable>
</MySiteLayout>
