---
import MySiteLayout from "../layouts/AboutNowLayout.astro";
import SortableTable from "../components/SortableTable.astro";
import { getSortedRecipes } from "../lib/recipes";

const recipes = getSortedRecipes();
---

<MySiteLayout frontmatter={{ title: "Recipes", navName: "lists" }}>
  <SortableTable>
    <thead>
      <tr>
        <th data-sort="asc" data-type="text">Recipe</th>
        <th data-sort="desc" data-type="text">Added</th>
        <th data-type="none">Source</th>
      </tr>
    </thead>
    <tbody>
      {
        recipes.map(recipe => (
          <tr>
            <td>
              <a href={recipe.url}>{recipe.frontmatter.title}</a>
            </td>
            <td>
              {recipe.frontmatter.added
                ? new Date(recipe.frontmatter.added + "-01").toLocaleDateString(
                    "en-US",
                    {
                      month: "short",
                      year: "numeric",
                    }
                  )
                : "–"}
            </td>
            <td>
              {recipe.frontmatter.source && (
                <a href={recipe.frontmatter.source.url}>link</a>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </SortableTable>
</MySiteLayout>
