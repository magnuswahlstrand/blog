---
import MySiteLayout from "../layouts/AboutNowLayout.astro";
import { calculateDuration, nowDate, resumeItems } from "../resume/resumeItems";
import ResumeItem from "../components/ResumeItem.astro";
---

<MySiteLayout frontmatter={{ title: "Resumé" }}>
  <div class="flex flex-row mb-3 items-end gap-1 text-skin-base">
    <div class="text-2xl font-bold">Experience</div>
    <div class="text-xs mb-1">({calculateDuration("Jan 2012", nowDate())})</div>
  </div>
  <div class="flex flex-col gap-6">
    {resumeItems.map(item => <ResumeItem {...item} />)}
  </div>
</MySiteLayout>
