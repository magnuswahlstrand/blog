---
import AboutNowLayout from "../../layouts/AboutNowLayout.astro";
import SortableTable from "../../components/SortableTable.astro";
import { loadGames, bggUrl } from "../../lib/games";
import type { Game } from "../../lib/games/schema";
import { gameStatusSchema } from "../../lib/games/schema";

const games = loadGames()
  .filter(game => game.status === "owned")
  .sort((a, b) => {
    const aSet = a.purchased != null;
    const bSet = b.purchased != null;
    if (aSet !== bSet) return aSet ? -1 : 1;
    if (!aSet) return 0;
    return b.purchased! - a.purchased!;
  });
---

<AboutNowLayout frontmatter={{ title: "Board Games", navName: "lists" }}>
  <SortableTable>
    <thead>
      <tr>
        <th data-type="text">Title</th>
        <th data-type="number">Year</th>
        <th data-type="text">Players</th>
        <th data-type="number">Purchased</th>
        <th data-type="text">Status</th>
        <th data-type="number">BGG Rating</th>
      </tr>
    </thead>
    <tbody>
      {
        games.map(game => (
          <tr>
            <td>{game.title}</td>
            <td>{game.year}</td>
            <td>{game.players}</td>
            <td>{game.purchased ?? "–"}</td>
            <td>
              <span class={`status ${game.status}`}>{game.status}</span>
            </td>
            <td>
              {bggUrl(game) ? (
                <a
                  class="rating-link"
                  href={bggUrl(game)}
                  title="View on BoardGameGeek"
                >
                  {game.bggRating?.toFixed(1)}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 3h-7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                    <path d="M14 3h7v7" />
                    <path d="M10 14 21 3" />
                  </svg>
                </a>
              ) : (
                (game.bggRating?.toFixed(1) ?? "–")
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </SortableTable>
</AboutNowLayout>

<style>
  td .status {
    @apply rounded-full px-2 py-0.5 text-xs uppercase tracking-wide;
  }
  td .status.owned {
    @apply bg-green-100 text-green-800;
  }
  :global(.theme-dark) td .status.owned {
    @apply bg-green-900/70 text-green-200;
  }
  td .status.considering {
    @apply bg-yellow-100 text-yellow-800;
  }
  :global(.theme-dark) td .status.considering {
    @apply bg-yellow-900/70 text-yellow-200;
  }
  td .rating-link {
    @apply inline-flex items-center gap-0.5 min-w-0 text-skin-base hover:text-skin-accent;
  }
  td .rating-link svg {
    @apply h-3 w-3 shrink-0 fill-none;
  }
</style>
