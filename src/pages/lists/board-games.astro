---
import AboutNowLayout from "../../layouts/AboutNowLayout.astro";
import SortableTable from "../../components/SortableTable.astro";
import { loadGames, bggUrl } from "../../lib/games";
import type { Game } from "../../lib/games/schema";
import { gameStatusSchema } from "../../lib/games/schema";

const games = loadGames().filter(game => game.status === "owned");
---

<AboutNowLayout frontmatter={{ title: "Board Games", navName: "lists" }}>
  <SortableTable>
    <thead>
      <tr>
        <th data-sort="asc" data-type="text">Title</th>
        <th data-type="number">Year</th>
        <th data-type="text">Players</th>
        <th data-type="number">Purchased</th>
        <th data-type="text">Status</th>
        <th data-type="number">BGG Rating</th>
        <th data-type="none">BGG</th>
      </tr>
    </thead>
    <tbody>
      {
        games.map(game => (
          <tr>
            <td>{game.title}</td>
            <td>{game.year}</td>
            <td>{game.players}</td>
            <td>{game.purchased ?? "–"}</td>
            <td>
              <span class={`status ${game.status}`}>{game.status}</span>
            </td>
            <td>{game.bggRating?.toFixed(1) ?? "–"}</td>
            <td>{bggUrl(game) && <a href={bggUrl(game)}>link</a>}</td>
          </tr>
        ))
      }
    </tbody>
  </SortableTable>
</AboutNowLayout>

<style>
  td .status {
    @apply rounded-full px-2 py-0.5 text-xs uppercase tracking-wide;
  }
  td .status.owned {
    @apply bg-green-100 text-green-800;
  }
  td .status.considering {
    @apply bg-yellow-100 text-yellow-800;
  }
</style>
